{
  "name": "itypora",
  "version": "0.4.0",
  "private": true,
  "description": "A local-first Markdown desktop editor",
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "wysiwyg",
    "typora-theme",
    "desktop"
  ],
  "homepage": "https://github.com/lhyf/ITypora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhyf/ITypora.git"
  },
  "bugs": {
    "url": "https://github.com/lhyf/ITypora/issues"
  },
  "author": "Itypora contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "dev": "npm run assets && vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "npm run assets && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "npm run build && node tests/desktop.mjs",
    "test:interface": "npm run build && node tests/interface.mjs",
    "test:preferences": "npm run build && node tests/preferences.mjs",
    "test:formatting": "npm run build && node tests/formatting.mjs",
    "test:table-dialog": "npm run build && node tests/table-dialog.mjs",
    "test:rendering": "npm run build && node tests/rendering.mjs",
    "test:theme-rendering": "npm run build && node tests/theme-rendering.mjs",
    "test:render-details": "npm run build && node tests/render-details.mjs",
    "test:code-editing": "npm run build && node tests/code-editing.mjs",
    "test:render-audit": "npm run build && node tests/render-audit.mjs after --all",
    "test:sidebar": "npm run build && node tests/sidebar.mjs",
    "test:save": "npm run build && node tests/save-preserve.mjs",
    "test:source-sync": "npm run build && node tests/source-sync.mjs",
    "test:zoom": "npm run build && node tests/zoom-viewer.mjs",
    "test:export": "npm run build && node tests/export.mjs",
    "test:images": "npm run build && node tests/image-paths.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "codemirror": "5.65.21",
    "dompurify": "^3.4.16",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@mathjax/mathjax-bbm-font-extension": "4.1.0",
    "@mathjax/mathjax-bboldx-font-extension": "4.1.0",
    "@mathjax/mathjax-dsfont-font-extension": "4.1.0",
    "@mathjax/mathjax-mhchem-font-extension": "4.1.0",
    "@mathjax/mathjax-newcm-font": "4.1.0",
    "@playwright/test": "^1.63.0",
    "@types/codemirror": "5.60.17",
    "@types/node": "^24.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "mathjax": "4.1.0",
    "typescript": "^5.9.0",
    "vditor": "^4.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "io.itypora.editor",
    "productName": "Itypora",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "Local-first Markdown editor",
      "maintainer": "Itypora contributors <https://github.com/lhyf/ITypora>"
    }
  }
}
